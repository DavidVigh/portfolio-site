# =============================================================================
# Portfolio site — environment variables
#
# Copy this file to .env.local and fill in the values. Required vars are marked
# below. NEVER commit .env.local; only this .env.example is in git.
# =============================================================================

# -----------------------------------------------------------------------------
# GitHub
# -----------------------------------------------------------------------------
# REQUIRED. Username whose public repos are shown in the Works section AND
# synced into Supabase by the daily cron job.
GITHUB_USERNAME=

# Optional but RECOMMENDED. A fine-grained or classic personal access token
# with `public_repo` (read) scope. Without it, GitHub limits unauthenticated
# requests to 60/hour per IP — easy to exhaust during local dev.
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Resend (email notifications for the contact / order form)
# -----------------------------------------------------------------------------
# REQUIRED. Get one at https://resend.com/api-keys
RESEND_API_KEY=

# REQUIRED. Inbox where order submissions are delivered (your email).
CONTACT_TO_EMAIL=

# REQUIRED. Verified sender address.
# - For local testing you can use "onboarding@resend.dev" but it can only
#   deliver to the email registered to your Resend account.
# - For production, use an address on a domain you've verified in Resend,
#   e.g. "Portfolio <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Supabase (orders + github_repos persistence)
# -----------------------------------------------------------------------------
# REQUIRED. Project URL — Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=

# REQUIRED. Anon (publishable) key. Used by the public client SDK.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REQUIRED. Service role (secret) key. Used ONLY server-side in API routes
# to insert/upsert rows. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Cron security
# -----------------------------------------------------------------------------
# REQUIRED. Long random string. Vercel Cron sends it as a Bearer token; you
# can also use it for manual triggers:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://<your-domain>/api/cron/github-sync
# Generate one with:  openssl rand -hex 32
CRON_SECRET=
